<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cnv_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/floor_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_floor_dashboard"
            android:textAppearance="@style/TextAppearance.CNV.Title" />

        <TextView
            android:id="@+id/floor_context"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.CNV.Caption" />

        <FrameLayout
            android:id="@+id/floor_status_header_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/floor_status_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <FrameLayout
            android:id="@+id/floor_list_header_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <FrameLayout
            android:id="@+id/floor_empty_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/floor_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_add_floor"
            style="@style/Widget.CNV.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="56dp"
            android:text="@string/setup_add_floor" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_register_dwg"
            style="@style/Widget.CNV.Button.Action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/setup_register_dwg" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_generate_route"
            style="@style/Widget.CNV.Button.Action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/setup_generate_route" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_create_zone"
            style="@style/Widget.CNV.Button.Action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/setup_create_zone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_route_lock"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/setup_route_lock" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_open_zones"
            style="@style/Widget.CNV.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/setup_open_zones" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_floor_back"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/nav_back" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
