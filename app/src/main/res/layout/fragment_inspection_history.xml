<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cnv_bg"
    android:padding="16dp">

    <TextView
        android:id="@+id/history_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/screen_history"
        android:textAppearance="@style/TextAppearance.CNV.Title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/history_search_layout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="8dp"
        android:hint="@string/ui_search"
        app:layout_constraintEnd_toStartOf="@id/button_history_sort"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/history_title">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/history_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:minHeight="48dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_history_sort"
        style="@style/Widget.CNV.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/history_sort"
        app:layout_constraintBottom_toBottomOf="@id/history_search_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/history_search_layout" />

    <TextView
        android:id="@+id/history_body"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:background="@color/cnv_surface"
        android:padding="14dp"
        android:text="@string/history_skeleton"
        android:textAppearance="@style/TextAppearance.CNV.Body"
        app:layout_constraintBottom_toTopOf="@id/button_history_heatmap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/history_search_layout" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_history_heatmap"
        style="@style/Widget.CNV.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:text="@string/screen_heatmap"
        app:layout_constraintBottom_toTopOf="@id/button_history_back"
        app:layout_constraintEnd_toStartOf="@id/button_history_csv"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_history_csv"
        style="@style/Widget.CNV.Button.Action"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="@string/zone_dash_csv"
        app:layout_constraintBottom_toBottomOf="@id/button_history_heatmap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/button_history_heatmap"
        app:layout_constraintTop_toTopOf="@id/button_history_heatmap" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_history_back"
        style="@style/Widget.CNV.Button.Secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/nav_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
