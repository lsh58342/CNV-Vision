<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cnv_bg"
    android:padding="16dp">

    <TextView
        android:id="@+id/developer_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/screen_developer"
        android:textAppearance="@style/TextAppearance.CNV.Title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/developer_body"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:background="@color/cnv_surface"
        android:padding="14dp"
        android:text="@string/developer_skeleton"
        android:textAppearance="@style/TextAppearance.CNV.Body"
        android:lineSpacingExtra="4dp"
        app:layout_constraintBottom_toTopOf="@id/button_developer_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/developer_title" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_developer_back"
        style="@style/Widget.CNV.Button.Secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/nav_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
