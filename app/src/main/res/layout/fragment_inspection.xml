<?xml version="1.0" encoding="utf-8"?>
<!--
  STEP 20-18: Camera fixed → Live Route (minHeight) → Scroll(Shock Graph + Dashboard).
  Never use weight=0 crush for Preview / Route / Graph.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cnv_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/inspection_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cnv_surface"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/inspection_zone_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.CNV.Title"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/inspection_session_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.CNV.Caption" />

        <TextView
            android:id="@+id/inspection_preflight_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#33FF5252"
            android:padding="8dp"
            android:textAppearance="@style/TextAppearance.CNV.Caption"
            android:textColor="#FF5252"
            android:visibility="gone" />

        <TextView
            android:id="@+id/inspection_speed_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/speed_mismatch_warning"
            android:textColor="#FF5252"
            android:textAppearance="@style/TextAppearance.CNV.Caption"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.camera.view.PreviewView
        android:id="@+id/inspection_preview"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="4dp"
        android:minHeight="160dp" />

    <com.example.cnv.ui.screen.inspection.LiveRouteViewer
        android:id="@+id/inspection_live_route"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="4dp"
        android:background="#FF1A1A1A"
        android:minHeight="120dp" />

    <TextView
        android:id="@+id/inspection_tracking_debug_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="#CC000000"
        android:fontFamily="monospace"
        android:maxLines="18"
        android:padding="6dp"
        android:text="TRACKING DEBUG"
        android:textColor="#FF00E676"
        android:textSize="10sp" />

    <ScrollView
        android:id="@+id/inspection_dashboard_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/insp_shock_graph_title"
                android:textAppearance="@style/TextAppearance.CNV.Caption"
                android:textStyle="bold" />

            <com.example.cnv.ui.screen.inspection.ShockGraphView
                android:id="@+id/inspection_shock_graph"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="160dp" />

            <include
                android:id="@+id/live_inspection_dashboard"
                layout="@layout/include_live_inspection_dashboard" />

            <FrameLayout
                android:id="@+id/inspection_status_header_slot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:id="@+id/inspection_status_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/inspection_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_inspection_start"
            style="@style/Widget.CNV.Button.Start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minHeight="56dp"
            android:text="@string/inspection_start" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_inspection_stop"
            style="@style/Widget.CNV.Button.Stop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minHeight="56dp"
            android:text="@string/inspection_stop" />
    </LinearLayout>
</LinearLayout>
