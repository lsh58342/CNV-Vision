<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/opencv_gray_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/opencv_gray_preview"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/imu_debug_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="IMU Debug" />

    <TextView
        android:id="@+id/fusion_debug_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imu_debug_hud"
        tools:text="Fusion Debug" />

    <TextView
        android:id="@+id/pipeline_perf_debug_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fusion_debug_hud"
        tools:text="Perf Debug" />

    <TextView
        android:id="@+id/map_debug_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pipeline_perf_debug_hud"
        tools:text="Map Debug" />

    <TextView
        android:id="@+id/dwg_debug_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/map_debug_hud"
        tools:text="DWG Debug" />

    <TextView
        android:id="@+id/route_gen_debug_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dwg_debug_hud"
        tools:text="Route Gen Debug" />

    <FrameLayout
        android:id="@+id/cad_container"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_margin="12dp"
        app:layout_constraintBottom_toTopOf="@id/button_open_calibration"
        app:layout_constraintEnd_toStartOf="@id/cad_debug_hud"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintStart_toStartOf="parent">

        <com.example.cnv.cad.CADView
            android:id="@+id/cad_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.cnv.heatmap.HeatMapOverlay
            android:id="@+id/heatmap_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />
    </FrameLayout>

    <TextView
        android:id="@+id/cad_debug_hud"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="12dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:textSize="10sp"
        app:layout_constraintBottom_toTopOf="@id/cad_selection_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/cad_container"
        app:layout_constraintTop_toTopOf="@id/cad_container"
        tools:text="CAD Debug" />

    <TextView
        android:id="@+id/cad_selection_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="6dp"
        android:textColor="@android:color/white"
        android:textSize="9sp"
        app:layout_constraintBottom_toBottomOf="@id/cad_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cad_container"
        tools:text="Selection" />

    <TextView
        android:id="@+id/heatmap_debug_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="4dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="6dp"
        android:textColor="@android:color/white"
        android:textSize="9sp"
        app:layout_constraintBottom_toTopOf="@id/heatmap_filter_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Shock HeatMap" />

    <LinearLayout
        android:id="@+id/heatmap_filter_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="4dp"
        android:background="#66000000"
        android:orientation="vertical"
        android:padding="6dp"
        app:layout_constraintBottom_toTopOf="@id/button_heat_toggle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/heatmap_timeline_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/heat_timeline_label"
            android:textColor="@android:color/white"
            android:textSize="9sp" />

        <SeekBar
            android:id="@+id/heatmap_timeline_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="0" />

        <SeekBar
            android:id="@+id/heatmap_timeline_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="1000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_heatmap_timeline_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:text="@string/heat_timeline_reset"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_heatmap_filter_apply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minHeight="36dp"
                android:text="@string/heat_filter_apply"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_heatmap_filter_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minHeight="36dp"
                android:text="@string/heat_filter_reset"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/heatmap_filter_shock_min"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/heat_filter_shock_min"
                android:inputType="numberDecimal"
                android:textColor="@android:color/white"
                android:textColorHint="#99FFFFFF"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/heatmap_filter_shock_max"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/heat_filter_shock_max"
                android:inputType="numberDecimal"
                android:textColor="@android:color/white"
                android:textColorHint="#99FFFFFF"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/heatmap_filter_conf_min"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/heat_filter_conf_min"
                android:inputType="numberDecimal"
                android:textColor="@android:color/white"
                android:textColorHint="#99FFFFFF"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/heatmap_filter_conf_max"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/heat_filter_conf_max"
                android:inputType="numberDecimal"
                android:textColor="@android:color/white"
                android:textColorHint="#99FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/heatmap_filter_segment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/heat_filter_segment"
                android:inputType="text"
                android:textColor="@android:color/white"
                android:textColorHint="#99FFFFFF"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/heatmap_filter_node"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/heat_filter_node"
                android:inputType="text"
                android:textColor="@android:color/white"
                android:textColorHint="#99FFFFFF"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/heatmap_filter_session"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/heat_filter_session"
                android:inputType="text"
                android:textColor="@android:color/white"
                android:textColorHint="#99FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_heat_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="4dp"
        android:text="@string/heat_toggle_shock"
        app:layout_constraintBottom_toTopOf="@id/cad_search_input"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/cad_search_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="4dp"
        android:hint="@string/cad_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:textColor="@android:color/white"
        android:textColorHint="#99FFFFFF"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/button_cad_goto_pos"
        app:layout_constraintEnd_toStartOf="@id/button_cad_search"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_cad_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="@string/cad_search"
        app:layout_constraintBottom_toBottomOf="@id/cad_search_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/cad_search_input" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_cad_goto_pos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="4dp"
        android:text="@string/cad_goto_pos"
        app:layout_constraintBottom_toTopOf="@id/button_cad_zoom_in"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_cad_goto_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/cad_goto_start"
        app:layout_constraintBottom_toBottomOf="@id/button_cad_goto_pos"
        app:layout_constraintStart_toEndOf="@id/button_cad_goto_pos"
        app:layout_constraintTop_toTopOf="@id/button_cad_goto_pos" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_cad_goto_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/cad_goto_end"
        app:layout_constraintBottom_toBottomOf="@id/button_cad_goto_pos"
        app:layout_constraintStart_toEndOf="@id/button_cad_goto_start"
        app:layout_constraintTop_toTopOf="@id/button_cad_goto_pos" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_cad_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/cad_center"
        app:layout_constraintBottom_toBottomOf="@id/button_cad_goto_pos"
        app:layout_constraintStart_toEndOf="@id/button_cad_goto_end"
        app:layout_constraintTop_toTopOf="@id/button_cad_goto_pos" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_cad_layer_grid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/cad_layer_grid"
        app:layout_constraintBottom_toBottomOf="@id/button_cad_goto_pos"
        app:layout_constraintStart_toEndOf="@id/button_cad_center"
        app:layout_constraintTop_toTopOf="@id/button_cad_goto_pos" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_cad_layer_node"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/cad_layer_node"
        app:layout_constraintBottom_toBottomOf="@id/button_cad_goto_pos"
        app:layout_constraintStart_toEndOf="@id/button_cad_layer_grid"
        app:layout_constraintTop_toTopOf="@id/button_cad_goto_pos" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_cad_layer_branch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/cad_layer_branch"
        app:layout_constraintBottom_toBottomOf="@id/button_cad_goto_pos"
        app:layout_constraintStart_toEndOf="@id/button_cad_layer_node"
        app:layout_constraintTop_toTopOf="@id/button_cad_goto_pos" />

    <com.example.cnv.debug.RouteDebugView
        android:id="@+id/route_debug_view"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/route_validation_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="4dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="6dp"
        android:textColor="@android:color/white"
        android:textSize="9sp"
        app:layout_constraintBottom_toTopOf="@id/route_issues_hud"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Route Validation" />

    <TextView
        android:id="@+id/route_issues_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="4dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:maxLines="2"
        android:padding="6dp"
        android:textColor="@android:color/white"
        android:textSize="8sp"
        app:layout_constraintBottom_toTopOf="@id/inspection_debug_hud"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Issues" />

    <TextView
        android:id="@+id/inspection_debug_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:textSize="10sp"
        app:layout_constraintBottom_toTopOf="@id/heatmap_debug_hud"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Inspection" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_cad_zoom_in"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="8dp"
        android:text="@string/cad_zoom_in"
        app:layout_constraintBottom_toTopOf="@id/cad_container"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_cad_zoom_out"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/cad_zoom_out"
        app:layout_constraintBottom_toBottomOf="@id/button_cad_zoom_in"
        app:layout_constraintStart_toEndOf="@id/button_cad_zoom_in"
        app:layout_constraintTop_toTopOf="@id/button_cad_zoom_in" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_cad_fit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/cad_fit"
        app:layout_constraintBottom_toBottomOf="@id/button_cad_zoom_in"
        app:layout_constraintStart_toEndOf="@id/button_cad_zoom_out"
        app:layout_constraintTop_toTopOf="@id/button_cad_zoom_in" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_cad_reset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/cad_reset"
        app:layout_constraintBottom_toBottomOf="@id/button_cad_zoom_in"
        app:layout_constraintStart_toEndOf="@id/button_cad_fit"
        app:layout_constraintTop_toTopOf="@id/button_cad_zoom_in" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_cad_theme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/cad_theme"
        app:layout_constraintBottom_toBottomOf="@id/button_cad_zoom_in"
        app:layout_constraintStart_toEndOf="@id/button_cad_reset"
        app:layout_constraintTop_toTopOf="@id/button_cad_zoom_in" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_route_zoom_in"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="@string/route_zoom_in"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_route_zoom_out"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="@string/route_zoom_out"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_inspection_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/inspection_start"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/button_cad_zoom_in"
        app:layout_constraintStart_toEndOf="@id/button_cad_theme"
        app:layout_constraintTop_toTopOf="@id/button_cad_zoom_in" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_inspection_stop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/inspection_stop"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/button_cad_zoom_in"
        app:layout_constraintStart_toEndOf="@id/button_inspection_start"
        app:layout_constraintTop_toTopOf="@id/button_cad_zoom_in" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_open_calibration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/open_calibration"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
