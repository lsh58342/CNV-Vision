<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cnv_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/history_session_detail_title"
            android:textAppearance="@style/TextAppearance.CNV.Title" />

        <TextView
            android:id="@+id/detail_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1A1A1A"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.CNV.Caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/conveyor_profile_section"
            android:textAppearance="@style/TextAppearance.CNV.Body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textAppearance="@style/TextAppearance.CNV.Caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/insp_shock_graph_title"
            android:textAppearance="@style/TextAppearance.CNV.Body"
            android:textStyle="bold" />

        <com.example.cnv.ui.screen.inspection.ShockGraphView
            android:id="@+id/detail_shock_graph"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="160dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/review_heatmap_section"
            android:textAppearance="@style/TextAppearance.CNV.Body"
            android:textStyle="bold" />

        <com.example.cnv.ui.screen.review.HeatMapPreviewView
            android:id="@+id/detail_heatmap_preview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/detail_heatmap_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.CNV.Caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/history_statistics_section"
            android:textAppearance="@style/TextAppearance.CNV.Body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail_statistics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textAppearance="@style/TextAppearance.CNV.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_detail_excel"
            style="@style/Widget.CNV.Button.Action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="52dp"
            android:text="@string/result_export_excel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_detail_heatmap"
            style="@style/Widget.CNV.Button.Action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="52dp"
            android:text="@string/history_open_heatmap" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_detail_replay"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/history_replay_future" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_detail_csv"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/history_csv_export" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_detail_delete"
            style="@style/Widget.CNV.Button.Stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/history_delete_session" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_detail_back"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/nav_back" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
