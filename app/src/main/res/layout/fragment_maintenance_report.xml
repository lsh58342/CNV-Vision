<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cnv_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_title"
            android:textAppearance="@style/TextAppearance.CNV.Title" />

        <TextView
            android:id="@+id/report_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.CNV.Caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/report_inspection_summary"
            android:textAppearance="@style/TextAppearance.CNV.Body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/report_inspection_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#1A1A1A"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.CNV.Caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/report_maintenance_summary"
            android:textAppearance="@style/TextAppearance.CNV.Body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/report_maintenance_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#1A1A1A"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.CNV.Caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/report_priority_issue"
            android:textAppearance="@style/TextAppearance.CNV.Body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/report_priority_issue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#2A1515"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.CNV.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_report_create_wo_priority"
            style="@style/Widget.CNV.Button.Action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/report_create_wo_priority" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/report_zone_issues"
            android:textAppearance="@style/TextAppearance.CNV.Body"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/report_zone_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/report_zone_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/report_zone_empty"
            android:textAppearance="@style/TextAppearance.CNV.Caption"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/report_issue_details"
            android:textAppearance="@style/TextAppearance.CNV.Body"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/report_issue_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/report_issue_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/report_issue_empty"
            android:textAppearance="@style/TextAppearance.CNV.Caption"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/report_heatmap_section"
            android:textAppearance="@style/TextAppearance.CNV.Body"
            android:textStyle="bold" />

        <com.example.cnv.ui.screen.review.HeatMapPreviewView
            android:id="@+id/report_heatmap_preview"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/report_heatmap_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.CNV.Caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/report_recommended_actions"
            android:textAppearance="@style/TextAppearance.CNV.Body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/report_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#1A1A1A"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.CNV.Caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/report_work_orders"
            android:textAppearance="@style/TextAppearance.CNV.Body"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/report_work_order_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/report_work_order_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/report_work_order_empty"
            android:textAppearance="@style/TextAppearance.CNV.Caption"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/report_export_section"
            android:textAppearance="@style/TextAppearance.CNV.Body"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_report_export_pdf"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/report_export_pdf" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_report_export_csv"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/report_export_csv" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_report_export_json"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/report_export_json" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_report_replay"
            style="@style/Widget.CNV.Button.Action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="52dp"
            android:text="@string/report_open_replay" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_report_back"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/nav_back" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
