<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cnv_bg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/workspace_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:textAppearance="@style/TextAppearance.CNV.Title" />

    <TextView
        android:id="@+id/workspace_context"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:textAppearance="@style/TextAppearance.CNV.Caption" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/workspace_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="scrollable"
        app:tabGravity="fill" />

    <FrameLayout
        android:id="@+id/workspace_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
