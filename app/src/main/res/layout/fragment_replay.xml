<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cnv_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/screen_replay"
            android:textAppearance="@style/TextAppearance.CNV.Title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_replay_fit"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/heatmap_fit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_replay_back"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:minHeight="44dp"
            android:text="@string/nav_back" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/replay_analysis_toolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_jump_shock"
                style="@style/Widget.CNV.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/replay_jump_shock" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_jump_zone"
                style="@style/Widget.CNV.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minHeight="44dp"
                android:text="@string/replay_jump_zone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_jump_low_conf"
                style="@style/Widget.CNV.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minHeight="44dp"
                android:text="@string/replay_jump_low_conf" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_jump_timestamp"
                style="@style/Widget.CNV.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minHeight="44dp"
                android:text="@string/replay_jump_timestamp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_jump_route"
                style="@style/Widget.CNV.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minHeight="44dp"
                android:text="@string/replay_jump_route" />
        </LinearLayout>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_prev_event"
                style="@style/Widget.CNV.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/replay_prev_event" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_next_event"
                style="@style/Widget.CNV.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minHeight="44dp"
                android:text="@string/replay_next_event" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_prev_shock"
                style="@style/Widget.CNV.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minHeight="44dp"
                android:text="@string/replay_prev_shock" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_next_shock"
                style="@style/Widget.CNV.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minHeight="44dp"
                android:text="@string/replay_next_shock" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_prev_zone"
                style="@style/Widget.CNV.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minHeight="44dp"
                android:text="@string/replay_prev_zone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_next_zone"
                style="@style/Widget.CNV.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minHeight="44dp"
                android:text="@string/replay_next_zone" />
        </LinearLayout>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/filter_shock_only"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/replay_filter_shock"
                android:textColor="@android:color/white" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/filter_low_conf_only"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/replay_filter_low_conf"
                android:textColor="@android:color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_filter_zone"
                style="@style/Widget.CNV.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="44dp"
                android:text="@string/replay_filter_zone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_filter_time"
                style="@style/Widget.CNV.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minHeight="44dp"
                android:text="@string/replay_filter_time" />
        </LinearLayout>
    </HorizontalScrollView>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="@string/replay_search_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/replay_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/replay_session_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.CNV.Body"
        android:textColor="@android:color/white" />

    <TextView
        android:id="@+id/replay_marker_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.CNV.Caption"
        android:textColor="@android:color/white" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <com.example.cnv.cad.CADView
            android:id="@+id/replay_cad_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.cnv.ui.screen.replay.ReplayOverlay
            android:id="@+id/replay_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/replay_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="16dp"
            android:textAppearance="@style/TextAppearance.CNV.Body"
            android:textColor="@android:color/white"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/replay_stats_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#33000000"
        android:padding="8dp"
        android:textAppearance="@style/TextAppearance.CNV.Caption"
        android:textColor="@android:color/white" />
</LinearLayout>
