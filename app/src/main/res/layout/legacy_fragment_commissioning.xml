<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cnv_bg"
    android:padding="16dp">

    <TextView
        android:id="@+id/commissioning_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/comm_home_title"
        android:textAppearance="@style/TextAppearance.CNV.Title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/commissioning_context"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="@style/TextAppearance.CNV.Caption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/commissioning_title" />

    <TextView
        android:id="@+id/commissioning_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/comm_workflow_hint"
        android:textAppearance="@style/TextAppearance.CNV.Body"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/commissioning_context" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_comm_dwg"
        style="@style/Widget.CNV.Button.Action"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/comm_step_dwg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/commissioning_hint" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_comm_route"
        style="@style/Widget.CNV.Button.Action"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/comm_step_route"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button_comm_dwg" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_comm_calibration"
        style="@style/Widget.CNV.Button.Action"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/comm_step_calibration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button_comm_route" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_comm_zone_editor"
        style="@style/Widget.CNV.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:text="@string/comm_step_zone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button_comm_calibration" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_comm_route_lock"
        style="@style/Widget.CNV.Button.Action"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/comm_step_route_lock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button_comm_zone_editor" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_comm_leave"
        style="@style/Widget.CNV.Button.Secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/comm_leave"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
