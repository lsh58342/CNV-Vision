<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cnv_bg"
    android:padding="16dp">

    <TextView
        android:id="@+id/settings_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textAppearance="@style/TextAppearance.CNV.Title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/settings_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="@style/TextAppearance.CNV.Caption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settings_title" />

    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/button_settings_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settings_status">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_operation_section"
                android:textAppearance="@style/TextAppearance.CNV.Caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_settings_camera"
                style="@style/Widget.CNV.Button.Action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_camera_skeleton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_settings_calibration"
                style="@style/Widget.CNV.Button.Action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/open_calibration" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_settings_about"
                style="@style/Widget.CNV.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_about" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/settings_role_hint"
                android:textAppearance="@style/TextAppearance.CNV.Caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_role_operator"
                style="@style/Widget.CNV.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_role_operator" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_role_admin"
                style="@style/Widget.CNV.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_role_admin" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_role_developer"
                style="@style/Widget.CNV.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_role_developer" />

            <TextView
                android:id="@+id/settings_admin_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/settings_admin_section"
                android:textAppearance="@style/TextAppearance.CNV.Caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_settings_developer"
                style="@style/Widget.CNV.Button.Action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/screen_developer"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_settings_commissioning"
                style="@style/Widget.CNV.Button.Action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_open_commissioning"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_settings_back"
        style="@style/Widget.CNV.Button.Secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/nav_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
