<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cnv_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/drawing_dash_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_drawing_dashboard"
            android:textAppearance="@style/TextAppearance.CNV.Title" />

        <TextView
            android:id="@+id/drawing_dash_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.CNV.Caption" />

        <FrameLayout
            android:id="@+id/drawing_dash_status_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/drawing_dash_status_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <FrameLayout
            android:id="@+id/drawing_dash_info_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/drawing_dash_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_drawing_register_dwg"
            style="@style/Widget.CNV.Button.Action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/setup_register_dwg" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_drawing_set_origin"
            style="@style/Widget.CNV.Button.Action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/setup_set_origin" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_drawing_calibration"
            style="@style/Widget.CNV.Button.Action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/comm_step_calibration" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_drawing_generate_route"
            style="@style/Widget.CNV.Button.Action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/setup_generate_route" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_drawing_create_zone"
            style="@style/Widget.CNV.Button.Action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/setup_create_zone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_drawing_route_lock"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/setup_route_lock" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_drawing_open_zones"
            style="@style/Widget.CNV.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/setup_open_zones" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_drawing_heatmap"
            style="@style/Widget.CNV.Button.Action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/op_open_heatmap" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_drawing_history"
            style="@style/Widget.CNV.Button.Action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/op_open_history" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_drawing_csv"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/op_open_csv" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_drawing_replay"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/setup_replay" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_drawing_delete"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/setup_delete_drawing" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_drawing_back"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/nav_back" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
