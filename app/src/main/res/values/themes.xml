<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.CNV" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/cnv_accent</item>
        <item name="android:statusBarColor">@color/cnv_bg</item>
        <item name="android:navigationBarColor">@color/cnv_bg</item>
        <item name="android:windowBackground">@color/cnv_bg</item>
    </style>

    <style name="Theme.CNV" parent="Base.Theme.CNV" />

    <style name="Widget.CNV.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.CNV.Button.Action" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.CNV.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.CNV.Button.Start" parent="Widget.CNV.Button.Primary">
        <item name="backgroundTint">@color/cnv_start</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.CNV.Button.Stop" parent="Widget.CNV.Button.Primary">
        <item name="backgroundTint">@color/cnv_stop</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CNV.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/cnv_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CNV.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/cnv_text_primary</item>
    </style>

    <style name="TextAppearance.CNV.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/cnv_text_secondary</item>
    </style>
</resources>
