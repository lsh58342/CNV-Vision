<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cnv_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/wiz_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.CNV.Caption"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/wiz_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="9" />

    <TextView
        android:id="@+id/wiz_step_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textAppearance="@style/TextAppearance.CNV.Title" />

    <TextView
        android:id="@+id/wiz_step_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.CNV.Caption" />

    <FrameLayout
        android:id="@+id/wiz_workspace"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_wiz_prev"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minHeight="52dp"
            android:text="@string/wiz_previous" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_wiz_next"
            style="@style/Widget.CNV.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minHeight="52dp"
            android:text="@string/wiz_next" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_wiz_finish"
        style="@style/Widget.CNV.Button.Start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="52dp"
        android:text="@string/wiz_finish"
        android:visibility="gone" />
</LinearLayout>
