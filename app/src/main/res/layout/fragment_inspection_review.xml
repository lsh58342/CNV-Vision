<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cnv_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/review_title"
            android:textAppearance="@style/TextAppearance.CNV.Title" />

        <TextView
            android:id="@+id/review_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.CNV.Caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/review_summary_section"
            android:textAppearance="@style/TextAppearance.CNV.Body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/review_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#1A1A1A"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.CNV.Caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/review_warning_section"
            android:textAppearance="@style/TextAppearance.CNV.Body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/review_warnings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#1A1A1A"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.CNV.Caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/review_heatmap_section"
            android:textAppearance="@style/TextAppearance.CNV.Body"
            android:textStyle="bold" />

        <com.example.cnv.ui.screen.review.HeatMapPreviewView
            android:id="@+id/review_heatmap_preview"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/review_heatmap_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.CNV.Caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/review_issue_section"
            android:textAppearance="@style/TextAppearance.CNV.Body"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/review_issue_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/review_issue_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/review_issue_empty"
            android:textAppearance="@style/TextAppearance.CNV.Caption"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/review_zone_section"
            android:textAppearance="@style/TextAppearance.CNV.Body"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/review_zone_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/review_zone_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/review_zone_empty"
            android:textAppearance="@style/TextAppearance.CNV.Caption"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/review_actions_section"
            android:textAppearance="@style/TextAppearance.CNV.Body"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_review_replay"
            style="@style/Widget.CNV.Button.Action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="52dp"
            android:text="@string/review_open_replay" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_review_heatmap"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/review_open_heatmap" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_review_report"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/review_export_report" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_review_csv"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/review_export_csv" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_review_detail"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/review_view_session_detail" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_review_back"
            style="@style/Widget.CNV.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/nav_back" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
