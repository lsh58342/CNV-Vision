<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/opencv_gray_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/opencv_gray_preview"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/imu_debug_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="IMU Debug" />

    <TextView
        android:id="@+id/fusion_debug_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imu_debug_hud"
        tools:text="Fusion Debug" />

    <TextView
        android:id="@+id/pipeline_perf_debug_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fusion_debug_hud"
        tools:text="Perf Debug" />

    <TextView
        android:id="@+id/map_debug_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pipeline_perf_debug_hud"
        tools:text="Map Debug" />

    <TextView
        android:id="@+id/dwg_debug_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/map_debug_hud"
        tools:text="DWG Debug" />

    <TextView
        android:id="@+id/route_gen_debug_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dwg_debug_hud"
        tools:text="Route Gen Debug" />

    <com.example.cnv.cad.CADView
        android:id="@+id/cad_view"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_margin="12dp"
        app:layout_constraintBottom_toTopOf="@id/button_open_calibration"
        app:layout_constraintEnd_toStartOf="@id/cad_debug_hud"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/cad_debug_hud"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="12dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="@id/cad_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/cad_view"
        app:layout_constraintTop_toTopOf="@id/cad_view"
        tools:text="CAD Debug" />

    <com.example.cnv.debug.RouteDebugView
        android:id="@+id/route_debug_view"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/route_validation_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="4dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="6dp"
        android:textColor="@android:color/white"
        android:textSize="9sp"
        app:layout_constraintBottom_toTopOf="@id/route_issues_hud"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Route Validation" />

    <TextView
        android:id="@+id/route_issues_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="4dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:maxLines="2"
        android:padding="6dp"
        android:textColor="@android:color/white"
        android:textSize="8sp"
        app:layout_constraintBottom_toTopOf="@id/inspection_debug_hud"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Issues" />

    <TextView
        android:id="@+id/inspection_debug_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:background="#66000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:textSize="10sp"
        app:layout_constraintBottom_toTopOf="@id/button_cad_zoom_in"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Inspection" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_cad_zoom_in"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="8dp"
        android:text="@string/cad_zoom_in"
        app:layout_constraintBottom_toTopOf="@id/cad_view"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_cad_zoom_out"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/cad_zoom_out"
        app:layout_constraintBottom_toBottomOf="@id/button_cad_zoom_in"
        app:layout_constraintStart_toEndOf="@id/button_cad_zoom_in"
        app:layout_constraintTop_toTopOf="@id/button_cad_zoom_in" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_cad_fit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/cad_fit"
        app:layout_constraintBottom_toBottomOf="@id/button_cad_zoom_in"
        app:layout_constraintStart_toEndOf="@id/button_cad_zoom_out"
        app:layout_constraintTop_toTopOf="@id/button_cad_zoom_in" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_cad_reset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/cad_reset"
        app:layout_constraintBottom_toBottomOf="@id/button_cad_zoom_in"
        app:layout_constraintStart_toEndOf="@id/button_cad_fit"
        app:layout_constraintTop_toTopOf="@id/button_cad_zoom_in" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_cad_theme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/cad_theme"
        app:layout_constraintBottom_toBottomOf="@id/button_cad_zoom_in"
        app:layout_constraintStart_toEndOf="@id/button_cad_reset"
        app:layout_constraintTop_toTopOf="@id/button_cad_zoom_in" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_route_zoom_in"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="@string/route_zoom_in"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_route_zoom_out"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="@string/route_zoom_out"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_inspection_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/inspection_start"
        app:layout_constraintBottom_toBottomOf="@id/button_cad_zoom_in"
        app:layout_constraintStart_toEndOf="@id/button_cad_theme"
        app:layout_constraintTop_toTopOf="@id/button_cad_zoom_in" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_inspection_stop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/inspection_stop"
        app:layout_constraintBottom_toBottomOf="@id/button_cad_zoom_in"
        app:layout_constraintStart_toEndOf="@id/button_inspection_start"
        app:layout_constraintTop_toTopOf="@id/button_cad_zoom_in" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_open_calibration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/open_calibration"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
