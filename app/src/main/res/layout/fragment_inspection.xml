<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/screen_inspection"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/inspection_preview_placeholder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="#22000000">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/inspection_preview_placeholder" />
    </FrameLayout>

    <TextView
        android:id="@+id/inspection_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="monospace"
        android:text="@string/inspection_status_skeleton" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_inspection_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/inspection_start" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_inspection_stop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/inspection_stop" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_inspection_to_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/inspection_to_result_skeleton" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_inspection_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nav_back" />
</LinearLayout>
