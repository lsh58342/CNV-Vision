<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="#1A1A1A"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/report_row_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.CNV.Body"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/report_row_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:textAppearance="@style/TextAppearance.CNV.Caption" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/report_row_action"
        style="@style/Widget.CNV.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minHeight="40dp"
        android:text="@string/report_create_wo"
        android:visibility="gone" />
</LinearLayout>
